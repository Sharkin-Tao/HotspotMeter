<Window x:Class="HotspotMeter.App.Views.GuardConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:HotspotMeter.App.Localization"
        Title="{loc:Tr Guard_ConfirmTitle}"
        Width="540" Height="388"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">
    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderStrong}"
            BorderThickness="1" CornerRadius="14" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.45" Color="#000000" />
        </Border.Effect>
        <Grid Margin="26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{loc:Tr Guard_ConfirmTitle}" FontSize="19" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" />
            <TextBlock Grid.Row="1" Text="{loc:Tr Guard_ConfirmMessage}" FontSize="12.5"
                       Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,16" />

            <Border Grid.Row="2" Background="{StaticResource BgRaised}" CornerRadius="10" Padding="14,12"
                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr Guard_ConfirmName}"
                               Foreground="{StaticResource TextTertiary}" FontSize="11" Margin="0,0,0,10" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding NameText}"
                               Foreground="{StaticResource TextPrimary}" FontSize="12" Margin="0,0,0,10"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr Guard_ConfirmPid}"
                               Foreground="{StaticResource TextTertiary}" FontSize="11" Margin="0,0,0,10" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PidText}"
                               Foreground="{StaticResource TextPrimary}" FontSize="12" Margin="0,0,0,10" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr Guard_ConfirmPath}"
                               Foreground="{StaticResource TextTertiary}" FontSize="11" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PathText}"
                               Foreground="{StaticResource TextSecondary}" FontSize="11"
                               TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="{loc:Tr Guard_ConfirmCancel}" Click="Cancel_Click"
                        Style="{StaticResource SettingButtonStyle}" Margin="0,0,10,0" MinWidth="92" />
                <Button Content="{loc:Tr Guard_ConfirmTerminate}" Click="Confirm_Click"
                        Style="{StaticResource DangerButtonStyle}" MinWidth="120" />
            </StackPanel>
        </Grid>
    </Border>
</Window>