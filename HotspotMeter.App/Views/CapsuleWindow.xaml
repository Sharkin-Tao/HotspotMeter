<Window x:Class="HotspotMeter.App.Views.CapsuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HotspotMeter.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="HotspotMeter"
        Width="320" Height="104"
        MinWidth="132" MinHeight="40"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        d:DataContext="{d:DesignInstance Type=vm:CapsuleViewModel}">

    <Window.ContextMenu>
        <ContextMenu Style="{StaticResource CapsuleContextMenuStyle}">
            <!--
                只对 MenuItem 应用隐式样式。不能给 ContextMenu.ItemContainerStyle 设 MenuItem 样式：
                WPF 会把该样式套到 Separator 上，菜单一打开就抛
                "用于类型 MenuItem 的样式不能应用于类型 Separator"（4C-3 修复的闪退根因）。
            -->
            <ContextMenu.Resources>
                <Style TargetType="MenuItem" BasedOn="{StaticResource CapsuleMenuItemStyle}" />
                <Style TargetType="Separator" BasedOn="{StaticResource CapsuleMenuSeparatorStyle}" />
            </ContextMenu.Resources>
            <MenuItem Header="流量统计" IsEnabled="False" ToolTip="阶段 5 实现" />
            <Separator />
            <MenuItem Header="{Binding PinMenuText}" Click="OnTogglePin" />
            <MenuItem Header="调整大小…" Click="OnOpenSizeSettings" />
            <Separator />
            <MenuItem Header="退出程序" Click="OnExit" />
        </ContextMenu>
    </Window.ContextMenu>

    <!-- 宽型圆角矩形：绿色/红色实心铺满，无边框、无内层卡片 -->
    <Border x:Name="CapsuleSurface"
            CornerRadius="{Binding CapsuleCornerRadius}"
            Background="{Binding Background}"
            ToolTip="{Binding TooltipText}"
            MouseLeftButtonDown="OnSurfaceMouseLeftButtonDown">
        <!--
            4C-8 精简布局：左侧只有本次会话流量数字，右侧只有上下行速度。
            Wi-Fi 图标、连接状态、'已使用流量'说明均已删除；连接状态只由底色表达。
            两个元素处在同一个 Grid 行且都 VerticalAlignment=Center，
            因此速度块中心严格等于流量数字中心（保持 4C-6 的对齐基准）。
        -->
        <Grid Margin="{Binding CapsuleContentMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
                流量数字放在 Viewbox 里：正常文本不放大；极端长文本（例如 999.9 GB）
                在窄胶囊中只会等比缩小，绝不会裁切或把速度块挤出窗口。
            -->
            <Viewbox Grid.Column="0"
                     Stretch="Uniform" StretchDirection="DownOnly"
                     HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock x:Name="TrafficValue"
                           Text="{Binding SessionText}"
                           FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
                           FontSize="{Binding TrafficFontSize}" FontWeight="SemiBold" Foreground="White"
                           LineHeight="{Binding TrafficLineHeight}" LineStackingStrategy="BlockLineHeight" />
            </Viewbox>

            <StackPanel x:Name="SpeedBlock" Grid.Column="1"
                        VerticalAlignment="Center" HorizontalAlignment="Right"
                        Grid.IsSharedSizeScope="True"
                        UseLayoutRounding="False"
                        Margin="{Binding SpeedBlockMargin}">
                <Grid HorizontalAlignment="Right">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SpeedArrow" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SpeedLabel" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SpeedValue" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="↓" FontSize="{Binding SpeedFontSize}" Foreground="#D9FFFFFF"
                               Margin="{Binding SpeedArrowMargin}" />
                    <TextBlock Grid.Column="1" Text="下载" FontSize="{Binding SpeedFontSize}" Foreground="#CCFFFFFF"
                               Margin="{Binding SpeedLabelMargin}"
                               Visibility="{Binding ShowSpeedLabels, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Grid.Column="2" Text="{Binding DownloadText}" FontSize="{Binding SpeedFontSize}" Foreground="White" />
                </Grid>
                <Grid HorizontalAlignment="Right" Margin="{Binding SpeedRowSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SpeedArrow" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SpeedLabel" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SpeedValue" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="↑" FontSize="{Binding SpeedFontSize}" Foreground="#D9FFFFFF"
                               Margin="{Binding SpeedArrowMargin}" />
                    <TextBlock Grid.Column="1" Text="上传" FontSize="{Binding SpeedFontSize}" Foreground="#CCFFFFFF"
                               Margin="{Binding SpeedLabelMargin}"
                               Visibility="{Binding ShowSpeedLabels, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Grid.Column="2" Text="{Binding UploadText}" FontSize="{Binding SpeedFontSize}" Foreground="White" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>