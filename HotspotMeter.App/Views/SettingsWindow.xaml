<Window x:Class="HotspotMeter.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HotspotMeter.App.ViewModels"
        xmlns:loc="clr-namespace:HotspotMeter.App.Localization"
        mc:Ignorable="d"
        Title="{loc:Tr Settings_WindowTitle}"
        Width="780" Height="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgApp}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <Window.Resources>
        <Style x:Key="LanguageRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface" Background="{StaticResource BgRaised}"
                                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                CornerRadius="8" Padding="12,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="Dot" Width="14" Height="14" CornerRadius="7"
                                        BorderBrush="{StaticResource BorderSelected}" BorderThickness="1.5"
                                        VerticalAlignment="Center">
                                    <Ellipse x:Name="Fill" Margin="3" Fill="{StaticResource AccentGreen}"
                                             Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource BgHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentGreen}" />
                                <Setter TargetName="Fill" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="28,22,28,10">
            <TextBlock Text="{loc:Tr Settings_Title}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Tr Settings_Subtitle}"
                       Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" Margin="28,6,28,0" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
            <StackPanel>
                <!-- 语言 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_LanguageSection}" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{loc:Tr Settings_LanguageHint}"
                                   Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="Language" Style="{StaticResource LanguageRadioStyle}"
                                         Content="简体中文" IsChecked="{Binding IsChinese, Mode=TwoWay}" />
                            <RadioButton GroupName="Language" Style="{StaticResource LanguageRadioStyle}"
                                         Content="English" IsChecked="{Binding IsEnglish, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 外观 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_AppearanceSection}" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{loc:Tr Settings_AppearanceHint}"
                                   Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,12" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{loc:Tr Settings_PresetMini}" Style="{StaticResource PresetButtonStyle}"
                                    Background="{Binding MiniPresetBackground}" Command="{Binding UseMiniCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="{loc:Tr Settings_PresetSmall}" Style="{StaticResource PresetButtonStyle}"
                                    Background="{Binding SmallPresetBackground}" Command="{Binding UseSmallCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="{loc:Tr Settings_PresetStandard}" Style="{StaticResource PresetButtonStyle}"
                                    Background="{Binding StandardPresetBackground}" Command="{Binding UseStandardCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="{loc:Tr Settings_PresetLarge}" Style="{StaticResource PresetButtonStyle}"
                                    Background="{Binding LargePresetBackground}" Command="{Binding UseLargeCommand}" />
                        </StackPanel>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{loc:Tr Settings_Width}" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBoxStyle}" />
                            <TextBlock Grid.Column="2" Text="{loc:Tr Settings_Height}" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextStyle}" Margin="16,0,8,0" />
                            <TextBox Grid.Column="3" Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBoxStyle}" />
                            <Button Grid.Column="4" Content="{loc:Tr Settings_Apply}" Command="{Binding ApplyCustomCommand}"
                                    Style="{StaticResource SettingButtonStyle}" Margin="12,0,0,0" />
                            <TextBlock Grid.Column="5" Text="{loc:Tr Settings_Dip}" VerticalAlignment="Center"
                                       Style="{StaticResource HintTextStyle}" Margin="10,0,0,0" />
                        </Grid>

                        <TextBlock Text="{loc:Tr Settings_SizeRangeHint}"
                                   Style="{StaticResource HintTextStyle}" Margin="0,8,0,0" />

                        <TextBlock Text="{Binding ValidationMessage}"
                                   Foreground="{StaticResource DangerText}" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVisibility}}" />

                        <!-- 尺寸预览：与真实胶囊同色、同比例 -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="248" Height="62" Background="{StaticResource BgRaised}"
                                    CornerRadius="10">
                                <Border Background="{StaticResource StateConnected}"
                                        CornerRadius="{Binding PreviewCornerRadius}"
                                        Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentSizeText}" Foreground="White" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding AspectRatioText}" VerticalAlignment="Bottom"
                                       Style="{StaticResource HintTextStyle}" Margin="14,0,0,4" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 位置行为 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_BehaviorSection}" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding PinStatusText}" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr Settings_PinName}" FontSize="12" />
                                <TextBlock Text="{loc:Tr Settings_PinHint}" Style="{StaticResource HintTextStyle}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{Binding PinButtonText}" Command="{Binding TogglePinCommand}"
                                    Style="{StaticResource SettingButtonStyle}" />
                        </Grid>

                        <Separator Background="{StaticResource BorderSubtle}" Margin="0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Tr Settings_AutoFitName}" FontSize="12" />
                                <TextBlock Text="{loc:Tr Settings_AutoFitHint}"
                                           Style="{StaticResource HintTextStyle}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding TaskbarStatusText}" Style="{StaticResource HintTextStyle}"
                                           Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding AutoFitHint}" Style="{StaticResource HintTextStyle}"
                                           Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource SwitchCheckBoxStyle}"
                                      IsChecked="{Binding AutoFitTaskbar, Mode=TwoWay}" VerticalAlignment="Center" />
                        </Grid>

                        <Separator Background="{StaticResource BorderSubtle}" Margin="0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr Settings_ResetName}" FontSize="12" />
                                <TextBlock Text="{loc:Tr Settings_ResetHint}" Style="{StaticResource HintTextStyle}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{loc:Tr Settings_ResetButton}" Command="{Binding ResetPositionCommand}"
                                    Style="{StaticResource SettingButtonStyle}" />
                        </Grid>

                        <TextBlock Text="{Binding PositionText}" Style="{StaticResource HintTextStyle}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- 程序行为 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_ProgramSection}" Style="{StaticResource SectionTitleStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <CheckBox Content="{loc:Tr Settings_ShowOnStartup}" Style="{StaticResource SwitchCheckBoxStyle}"
                                      IsChecked="{Binding StartupVisible, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock Text="{loc:Tr Settings_ShowOnStartupHint}"
                                   Style="{StaticResource HintTextStyle}" Margin="0,8,0,0" />

                        <Separator Background="{StaticResource BorderSubtle}" Margin="0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Tr Settings_AutoStartName}" FontSize="12" />
                                <TextBlock Text="{Binding StartupStatusText}" Style="{StaticResource HintTextStyle}"
                                           Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource SwitchCheckBoxStyle}"
                                      IsChecked="{Binding AutoStart, Mode=TwoWay}" VerticalAlignment="Center" />
                        </Grid>

                        <Separator Background="{StaticResource BorderSubtle}" Margin="0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Tr Settings_StatsTaskbarName}" FontSize="12" />
                                <TextBlock Text="{loc:Tr Settings_StatsTaskbarHint}"
                                           Style="{StaticResource HintTextStyle}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource SwitchCheckBoxStyle}"
                                      IsChecked="{Binding ShowStatsInTaskbar, Mode=TwoWay}" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="{loc:Tr Settings_FooterNote}"
                                   Style="{StaticResource HintTextStyle}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部 -->
        <Grid Grid.Row="2" Margin="28,10,28,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:Tr Settings_AllChangesSaved}" Style="{StaticResource HintTextStyle}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="{loc:Tr Settings_Done}" Style="{StaticResource PrimaryButtonStyle}"
                    Width="96" Height="34" Click="OnClose" IsDefault="True" />
        </Grid>
    </Grid>
</Window>