<Window x:Class="HotspotMeter.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HotspotMeter.App.ViewModels"
        mc:Ignorable="d"
        Title="设置 — HotspotMeter"
        Width="780" Height="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgApp}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="28,22,28,10">
            <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="调整悬浮胶囊的外观、位置与启动行为，修改立即生效。"
                       Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" Margin="28,6,28,0" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
            <StackPanel>
                <!-- 外观 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="悬浮胶囊外观" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="四种尺寸均按 320 : 104 等比例缩放，内部布局与标准尺寸完全一致，修改立即生效。"
                                   Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,12" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="迷你 · 220 × 71.5" Style="{StaticResource PresetButtonStyle}"
                                    Background="{Binding MiniPresetBackground}" Command="{Binding UseMiniCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="小型 · 280 × 91" Style="{StaticResource PresetButtonStyle}"
                                    Background="{Binding SmallPresetBackground}" Command="{Binding UseSmallCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="标准 · 320 × 104" Style="{StaticResource PresetButtonStyle}"
                                    Background="{Binding StandardPresetBackground}" Command="{Binding UseStandardCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="大型 · 400 × 130" Style="{StaticResource PresetButtonStyle}"
                                    Background="{Binding LargePresetBackground}" Command="{Binding UseLargeCommand}" />
                        </StackPanel>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="宽度" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBoxStyle}" />
                            <TextBlock Grid.Column="2" Text="高度" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextStyle}" Margin="16,0,8,0" />
                            <TextBox Grid.Column="3" Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBoxStyle}" />
                            <Button Grid.Column="4" Content="应用" Command="{Binding ApplyCustomCommand}"
                                    Style="{StaticResource SettingButtonStyle}" Margin="12,0,0,0" />
                            <TextBlock Grid.Column="5" Text="DIP" VerticalAlignment="Center"
                                       Style="{StaticResource HintTextStyle}" Margin="10,0,0,0" />
                        </Grid>

                        <TextBlock Text="宽度 220–480 DIP · 高度 71.5–156 DIP · 宽高比固定为 320 : 104"
                                   Style="{StaticResource HintTextStyle}" Margin="0,8,0,0" />

                        <TextBlock Text="{Binding ValidationMessage}"
                                   Foreground="{StaticResource DangerText}" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVisibility}}" />

                        <!-- 尺寸预览：与真实胶囊同色、同比例 -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="248" Height="62" Background="{StaticResource BgRaised}"
                                    CornerRadius="10">
                                <Border Background="{StaticResource StateConnected}"
                                        CornerRadius="{Binding PreviewCornerRadius}"
                                        Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentSizeText}" Foreground="White" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding AspectRatioText}" VerticalAlignment="Bottom"
                                       Style="{StaticResource HintTextStyle}" Margin="14,0,0,4" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 位置行为 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="悬浮胶囊行为" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding PinStatusText}" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="位置固定" FontSize="12" />
                                <TextBlock Text="固定后禁止拖动，避免误触；随时可以解除。" Style="{StaticResource HintTextStyle}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{Binding PinButtonText}" Command="{Binding TogglePinCommand}"
                                    Style="{StaticResource SettingButtonStyle}" />
                        </Grid>

                        <Separator Background="{StaticResource BorderSubtle}" Margin="0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="自动适配任务栏" FontSize="12" />
                                <TextBlock Text="按当前显示器 DPI 与任务栏实际厚度自动调整胶囊尺寸，位置仍由你拖动；不会自动停靠或寻找任务栏空隙。"
                                           Style="{StaticResource HintTextStyle}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding TaskbarStatusText}" Style="{StaticResource HintTextStyle}"
                                           Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding AutoFitHint}" Style="{StaticResource HintTextStyle}"
                                           Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource SwitchCheckBoxStyle}"
                                      IsChecked="{Binding AutoFitTaskbar, Mode=TwoWay}" VerticalAlignment="Center" />
                        </Grid>

                        <Separator Background="{StaticResource BorderSubtle}" Margin="0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="恢复默认位置" FontSize="12" />
                                <TextBlock Text="回到主屏右下角、任务栏上方，并保留当前尺寸。" Style="{StaticResource HintTextStyle}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="恢复默认位置" Command="{Binding ResetPositionCommand}"
                                    Style="{StaticResource SettingButtonStyle}" />
                        </Grid>

                        <TextBlock Text="{Binding PositionText}" Style="{StaticResource HintTextStyle}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- 程序行为 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="程序行为" Style="{StaticResource SectionTitleStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <CheckBox Content="启动时显示悬浮胶囊" Style="{StaticResource SwitchCheckBoxStyle}"
                                      IsChecked="{Binding StartupVisible, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock Text="关闭后启动时只保留托盘图标，后台监控仍然运行。"
                                   Style="{StaticResource HintTextStyle}" Margin="0,8,0,0" />

                        <Separator Background="{StaticResource BorderSubtle}" Margin="0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="开机自动启动 HotspotMeter" FontSize="12" />
                                <TextBlock Text="{Binding StartupStatusText}" Style="{StaticResource HintTextStyle}"
                                           Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource SwitchCheckBoxStyle}"
                                      IsChecked="{Binding AutoStart, Mode=TwoWay}" VerticalAlignment="Center" />
                        </Grid>

                        <Separator Background="{StaticResource BorderSubtle}" Margin="0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="统计窗口出现在任务栏" FontSize="12" />
                                <TextBlock Text="控制独立流量统计窗口是否拥有任务栏按钮，与“自动适配任务栏”无关；关闭后仍可从托盘打开。"
                                           Style="{StaticResource HintTextStyle}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource SwitchCheckBoxStyle}"
                                      IsChecked="{Binding ShowStatsInTaskbar, Mode=TwoWay}" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="关闭设置或统计窗口不会停止监控；退出程序请使用托盘菜单或胶囊右键菜单。"
                                   Style="{StaticResource HintTextStyle}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部 -->
        <Grid Grid.Row="2" Margin="28,10,28,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="所有更改会立即应用并保存。" Style="{StaticResource HintTextStyle}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="完成" Style="{StaticResource PrimaryButtonStyle}"
                    Width="96" Height="34" Click="OnClose" IsDefault="True" />
        </Grid>
    </Grid>
</Window>