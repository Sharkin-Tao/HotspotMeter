<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>HotspotMeter</AssemblyName>
    <RootNamespace>HotspotMeter.App</RootNamespace>
    <!-- 首个正式发布版本；此前只有开发阶段提交，没有已发布版本号可继承。 -->
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\HotspotMeter.ico</ApplicationIcon>
    <!--
      WFO0003：WinForms 建议改用 ApplicationHighDpiMode 配置 DPI。
      本程序的 DPI 感知由 WPF 的 app.manifest（PerMonitorV2）负责，
      WinForms 只用于 NotifyIcon，因此保留 manifest 并显式关闭该建议。
    -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <!--
    UseWindowsForms 会启用 System.Windows.Forms / System.Drawing 的隐式 using，
    这与 WPF 的同名类型（Application、Color、MessageBox 等）冲突。
    只在托盘实现里显式别名引用，其余代码保持纯 WPF。
  -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HotspotMeter.Core\HotspotMeter.Core.csproj" />
    <ProjectReference Include="..\HotspotMeter.Infrastructure\HotspotMeter.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- 图标与图片作为资源嵌入，托盘/窗口都从程序集读取。 -->
  <ItemGroup>
    <Resource Include="Assets\HotspotMeter.ico" />
    <Resource Include="Assets\HotspotMeter-256.png" />
  </ItemGroup>

</Project>